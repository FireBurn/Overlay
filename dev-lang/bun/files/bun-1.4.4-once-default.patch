+// `Once` implements `Default` only from Rust 1.100.
+impl Default for Start {
+    fn default() -> Self {
+        Self {
+            initialize: std::sync::Once::new(),
+            is_for_few: AtomicBool::default(),
+            memory: std::sync::OnceLock::new(),
+        }
+    }
