+ * THE SOFTWARE.
+ ******************************************************************************/
+
+#pragma once
+
+// Qt6 dropped QX11Info. Its replacement is the X11 native interface, which only
+// exists when Qt itself was built with xcb support, so both of these can return
+// NULL there where QX11Info would always have answered.
+
+#include <QtGlobal>
+
+struct _XDisplay;
+typedef struct _XDisplay Display;
+struct xcb_connection_t;
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+
+#include <QtGui/qguiapplication_platform.h>
+#include <QGuiApplication>
+
+inline Display *RDX11Display()
+{
+#if QT_CONFIG(xcb)
+  if(auto *x11 = qGuiApp->nativeInterface<QNativeInterface::QX11Application>())
+    return x11->display();
+#endif
+  return NULL;
+}
+
+inline xcb_connection_t *RDX11Connection()
+{
+#if QT_CONFIG(xcb)
+  if(auto *x11 = qGuiApp->nativeInterface<QNativeInterface::QX11Application>())
+    return x11->connection();
+#endif
+  return NULL;
+}
+
+#else
+
+#include <QX11Info>
+
+inline Display *RDX11Display()
+{
+  return QX11Info::display();
+}
+
+inline xcb_connection_t *RDX11Connection()
+{
+  return QX11Info::connection();
+}
+
+#endif
