   return rdcstr(left) += right;
 }
 
+// Qt 6 added QString::operator+=(QUtf8StringView), which an rdcstr converts to
+// just as readily as it does to QString. Take the ambiguity away with an exact
+// match.
+inline QString &operator+=(QString &left, const rdcstr &right)
+{
+  return left += QString(right);
+}
+
 inline rdcstr operator+(const QChar &left, const rdcstr &right)
 {
   return rdcstr(left) += right;
@@ -1171,6 +1179,26 @@ public:
 #endif
 };
 
+#if defined(RENDERDOC_QT_COMPAT)
+// as for rdcstr, take away the QString/QUtf8StringView ambiguity Qt 6 creates
+inline QString &operator+=(QString &left, const rdcinflexiblestr &right)
+{
+  return left += QString(right);
+}
+
+// likewise, concatenating onto an rdcinflexiblestr only went through QString,
+// and Qt 6 added an rvalue operator+ that ties with the const reference one
+inline rdcstr operator+(const rdcinflexiblestr &left, const rdcstr &right)
+{
+  return rdcstr(left) += right;
+}
+
+inline rdcstr operator+(const rdcinflexiblestr &left, const char *const right)
+{
+  return rdcstr(left) += right;
+}
+#endif
