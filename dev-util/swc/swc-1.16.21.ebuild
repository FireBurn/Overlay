inherit cargo

DESCRIPTION="Native Node.js binding of the SWC JavaScript and TypeScript compiler"
HOMEPAGE="https://swc.rs/"
SRC_URI="
	https://github.com/swc-project/swc/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${P}"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD BSD-2 Boost-1.0
	CC0-1.0 ISC MIT MPL-2.0 Unicode-3.0
"
SLOT="${PV}"
KEYWORDS="~amd64 ~arm64"

src_prepare() {
	default
	# Upstream builds with nightly; -Zshare-generics is nightly only
	sed -i "s/, *\"-Zshare-generics=y\"//; s/\"-Zshare-generics=y\", *//; s/\[\"-Zshare-generics=y\"\]/[]/" \
		.cargo/config.toml || die
}

src_configure() {
	cargo_src_configure --frozen
}

src_compile() {
	# The wasm plugin host (wasmer) calls __rust_probestack, which current
	# Rust no longer provides, so the addon would not load
	cargo_src_compile -p binding_core_node --no-default-features --features swc_v1
}

src_test() {
	:
}

src_install() {
	insinto /usr/$(get_libdir)/${P}
	newins "$(cargo_target_dir)/libbinding_core_node.so" swc.node
	fperms 0755 /usr/$(get_libdir)/${P}/swc.node
}
