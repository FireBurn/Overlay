NPM_PNPM_VERSION="11.24.0"

inherit edo multilib npm wrapper

DESCRIPTION="The open source AI coding agent for the terminal by Qwen"
HOMEPAGE="https://github.com/QwenLM/qwen-code"
SRC_URI="
	https://github.com/QwenLM/qwen-code/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${NPM_PKG_URIS}
"
S="${WORKDIR}/${P}"

LICENSE="Apache-2.0"
# Bundled npm packages
LICENSE+=" 0BSD Apache-2.0 BSD BSD-2 CC0-1.0 ISC MIT MPL-2.0 Unlicense"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
RESTRICT="mirror test"

RDEPEND="
	>=net-libs/nodejs-22
	dev-vcs/git
	sys-apps/ripgrep
"
BDEPEND="${NPM_NODE_DEPEND}"

src_prepare() {
	default

	npm_clean_npmrc

	# The HTML export build enforces a size budget that upstream meets with
	# their own minifier build; ours comes out a couple of percent larger
	sed -i 's/^const MAX_DOCUMENT_RUNTIME_BYTES = .*/const MAX_DOCUMENT_RUNTIME_BYTES = Infinity;/' \
		packages/web-templates/src/export-html/build.mjs ||
		die "Failed to lift the document export size budget"
}

src_compile() {
	# Upstream's prepare script builds and bundles during install
	export QWEN_SKIP_PREPARE=1
	npm_with_registry pnpm install --frozen-lockfile
	edo pnpm --recursive run build
	edo pnpm run bundle

	# The bundle leaves node-pty external; upstream ships it prebuilt
	local pty="${WORKDIR}/pty"
	mkdir -p "${pty}" || die
	# A package.json of its own: npm would otherwise try to resolve the
	# whole project, dev dependencies included
	echo '{ "name": "qwen-code-pty", "private": true }' > "${pty}/package.json" || die
	pushd "${pty}" >/dev/null || die
	npm_with_registry npm install --omit=dev --omit=optional --no-package-lock \
		--no-save --ignore-scripts node-pty@1.1.0
	npm_remove_prebuilds
	npm_rebuild_native
	popd >/dev/null || die
}

src_install() {
	local home="/usr/$(get_libdir)/${PN}"

	insinto "${home}"
	doins -r dist "${WORKDIR}/pty/node_modules"

	make_wrapper qwen "${EPREFIX}/usr/bin/node ${EPREFIX}${home}/dist/cli.js"

	dodoc README.md
}
