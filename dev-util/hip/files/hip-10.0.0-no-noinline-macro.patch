Defining __noinline__ as a macro breaks libstdc++ >= 16 headers
(<format>, <chrono> via chrono_io.h, <stacktrace>) which use
__noinline__ as an identifier in [[__gnu__::__noinline__]] attributes.
The empty definition in the non-clang-HIP branch is of no use to
host code anyway, so drop it.

--- a/hipamd/include/hip/amd_detail/host_defines.h
+++ b/hipamd/include/hip/amd_detail/host_defines.h
@@ -397,7 +397,6 @@
 
 #define __global__
 
-#define __noinline__
 #define __forceinline__ inline
 
 #define __shared__
