	sst-linux-x86@4.13.1
	sst-win32-arm64@4.13.1
	sst-win32-x64@4.13.1
	sst-win32-x86@4.13.1
"

# Dependencies that are not published to the registry: a preview build of
# @solidjs/start and a fork of ghostty-web, both used by the embedded web UI
SOLID_START_BUILD="dfb2020"
GHOSTTY_WEB_COMMIT="83c0a07b8628b748aed073b232cb4b52a6ca11c1"

inherit edo npm shell-completion

DESCRIPTION="The open source AI coding agent (CLI)"
HOMEPAGE="https://opencode.ai https://github.com/anomalyco/opencode"
SRC_URI="
	https://github.com/anomalyco/opencode/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	https://pkg.pr.new/@solidjs/start@${SOLID_START_BUILD}
		-> solidjs-start-${SOLID_START_BUILD}.npm.tgz
	https://github.com/anomalyco/ghostty-web/archive/${GHOSTTY_WEB_COMMIT}.tar.gz
		-> ghostty-web-${GHOSTTY_WEB_COMMIT:0:10}.gh.tar.gz
	${NPM_PKG_URIS}
"
S="${WORKDIR}/${PN}-${PV}"

LICENSE="MIT"
# Dependent npm package licenses
LICENSE+="
	0BSD Apache-2.0 BlueOak-1.0.0 BSD BSD-2 CC0-1.0 ISC MIT MPL-2.0 Unlicense
	|| ( MIT WTFPL-2 ) || ( BSD GPL-2 )
"
SLOT="0"
KEYWORDS="~amd64"
# No strip: the binary is a bun single-file executable and carries the
# application bundle after the ELF image
RESTRICT="mirror strip test"

RDEPEND="dev-vcs/git"
BDEPEND="
	${NPM_NODE_DEPEND}
	>=dev-lang/bun-1.3.14
"

src_prepare() {
	default

	npm_clean_npmrc

	# bun installs the dev dependencies of a dependency it is given as a
	# directory, so pack the fork the way the registry would serve it
	mv "${WORKDIR}/ghostty-web-${GHOSTTY_WEB_COMMIT}" "${WORKDIR}/package" || die
	tar -czf "${WORKDIR}/ghostty-web.tgz" -C "${WORKDIR}" package || die

	# Point the two non-registry dependencies at the distfiles
	sed -i "s|\"https://pkg.pr.new/@solidjs/start@${SOLID_START_BUILD}\"|\"file:${DISTDIR}/solidjs-start-${SOLID_START_BUILD}.npm.tgz\"|" \
		package.json || die
	sed -i "s|\"github:anomalyco/ghostty-web#${GHOSTTY_WEB_COMMIT}\"|\"file:${WORKDIR}/ghostty-web.tgz\"|" \
		packages/app/package.json || die
}

src_compile() {
	# The bundle bakes in a snapshot of the model catalogue; opencode
	# refreshes it from models.dev on first run anyway
	echo '{}' > "${T}/models.json" || die
	export MODELS_DEV_API_JSON="${T}/models.json"
	export OPENCODE_VERSION="${PV}" OPENCODE_CHANNEL="latest"

	npm_with_registry bun install

	# --single builds for the host only; --skip-install keeps the build from
	# pulling every platform's prebuilt native libraries
	cd packages/opencode || die
	edo bun run script/build.ts --single --skip-install
}

src_install() {
	dobin packages/opencode/dist/opencode-linux-*/bin/opencode

	newbashcomp "${FILESDIR}/opencode.bash" opencode
}
