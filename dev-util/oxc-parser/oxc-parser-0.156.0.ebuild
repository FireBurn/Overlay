inherit cargo

DESCRIPTION="Native Node.js binding of the Oxc JavaScript parser"
HOMEPAGE="https://oxc.rs/ https://github.com/oxc-project/oxc"
SRC_URI="
	https://github.com/oxc-project/oxc/archive/refs/tags/crates_v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/oxc-crates_v${PV}"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD CDLA-Permissive-2.0 ISC MIT MIT-0 MPL-2.0 Unicode-3.0
	ZLIB
	|| ( Apache-2.0-with-LLVM-exceptions Boost-1.0 )
"
SLOT="${PV}"
KEYWORDS="~amd64 ~arm64"

src_configure() {
	cargo_src_configure --frozen
}

src_compile() {
	cargo_src_compile -p oxc_parser_napi
}

src_test() {
	:
}

src_install() {
	insinto /usr/$(get_libdir)/${P}
	newins "$(cargo_target_dir)/liboxc_parser_napi.so" parser.node
	fperms 0755 /usr/$(get_libdir)/${P}/parser.node
}
