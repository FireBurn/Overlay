From: Gentoo Overlay <gentoo@localhost>
Subject: [PATCH] devtools: explicitly include undefined in response property type

TypeScript isolated declaration emit cannot infer the undefined union for
this optional constructor parameter property. Spell it out while keeping
the argument optional and preserving runtime behavior.

--- a/third_party/devtools-frontend/src/front_end/core/host/DispatchHttpRequestClient.ts
+++ b/third_party/devtools-frontend/src/front_end/core/host/DispatchHttpRequestClient.ts
@@ -14,7 +14,7 @@
 }
 
 export class DispatchHttpRequestError extends Error {
-  constructor(readonly type: ErrorType, readonly response?: DispatchHttpRequestResult, options?: ErrorOptions) {
+  constructor(readonly type: ErrorType, readonly response?: DispatchHttpRequestResult|undefined, options?: ErrorOptions) {
     super(undefined, options);
   }
 }
