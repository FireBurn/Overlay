LLVM's libc gives the GNU strerror_r, returning char *, as glibc does.

--- a/security/sandbox/chromium/base/posix/safe_strerror.cc
+++ b/security/sandbox/chromium/base/posix/safe_strerror.cc
@@ -18,7 +18,7 @@
 
 namespace base {
 
-#if defined(__GLIBC__)
+#if defined(__GLIBC__) || defined(__LLVM_LIBC__)
 #define USE_HISTORICAL_STRERROR_R 1
 // Post-L versions of bionic define the GNU-specific strerror_r if _GNU_SOURCE
 // is defined, but the symbol is renamed to __gnu_strerror_r which only exists
