@@ -1370,7 +1370,7 @@
     globalParameters["StinkyTofuArchName"] = tuningArchOf(steppings[0]) if steppings else ""
 
     asmToolchain = makeAssemblyToolchain(
-        cxxCompiler,
+        assembler,
         offloadBundler,
         arguments["CodeObjectVersion"],
         arguments["BuildIdKind"],
