--- a/tensilelite/rocisa/rocisa/src/pass/macro_inline.cpp
+++ b/tensilelite/rocisa/rocisa/src/pass/macro_inline.cpp
@@ -319,6 +319,11 @@
                 if(branch.back())
                     output.push_back(cloneAndSubstitute(instruction, params));
             }
+            else if(auto text = std::dynamic_pointer_cast<TextBlock>(item))
+            {
+                if(branch.back())
+                    output.push_back(text->clone());
+            }
             else
             {
                 assert(false && "macroToInstruction: unexpected item type in macro body");
