From: FireBurn <fireburn@users.noreply.github.com>
Date: Sun, 20 Sep 2026 00:00:00 +0100
Subject: [PATCH] Separate library validation and assembler selection

diff -ru a/cmake/hipblaslt_codegen.cmake b/cmake/hipblaslt_codegen.cmake
--- a/cmake/hipblaslt_codegen.cmake
+++ b/cmake/hipblaslt_codegen.cmake
@@ -137,7 +137,7 @@
 function(create_device_library)
     set(_opts HOST_ASAN HOST_TSAN)
     set(_one
-        TARGET LOGIC_PATH OUTPUT_DIR CODEGEN_ROOT PYTHON_EXECUTABLE CXX_COMPILER OFFLOAD_BUNDLER JOBS LOGIC_FILTER
+        TARGET LOGIC_PATH OUTPUT_DIR CODEGEN_ROOT PYTHON_EXECUTABLE CXX_COMPILER ASSEMBLER OFFLOAD_BUNDLER JOBS LOGIC_FILTER
         ASAN YAML_FORMAT NO_COMPRESS EXPERIMENTAL GEMM_A2A_FUSION LAZY_LOAD ASM_COMMENTS
         KEEP_BUILD_TMP ASM_DEBUG)
     set(_multi ARCHES)
@@ -261,6 +261,9 @@
 
     list(JOIN _cdl_ARCHES "$<SEMICOLON>" _arches_semi)
     set(_opts_list "--architecture=${_arches_semi}" "--cxx-compiler=${_cdl_CXX_COMPILER}")
+    if(_cdl_ASSEMBLER)
+        list(APPEND _opts_list "--assembler=${_cdl_ASSEMBLER}")
+    endif()
     if(_cdl_OFFLOAD_BUNDLER)
         list(APPEND _opts_list "--offload-bundler=${_cdl_OFFLOAD_BUNDLER}")
     endif()
@@ -362,6 +365,9 @@
         VERBATIM
         USES_TERMINAL
     )
+    add_custom_target(${_cdl_TARGET}-validate
+        DEPENDS "${_logic_stamp}"
+    )
 
     # All architectures go to this one command, a stepping included. Covering a
     # stepping and the architecture it steps from takes more than one run, since
@@ -381,7 +387,7 @@
         COMMENT "Building device libraries to ${_cdl_OUTPUT_DIR} ..."
         COMMAND ${_tcl_command}
         COMMAND ${CMAKE_COMMAND} -E touch "${_output_stamp}"
-        DEPENDS ${_logic_stamp}
+        DEPENDS ${_codegen_dependencies}
         VERBATIM
         USES_TERMINAL
     )
diff -ru a/device-library/CMakeLists.txt b/device-library/CMakeLists.txt
--- a/device-library/CMakeLists.txt
+++ b/device-library/CMakeLists.txt
@@ -4,6 +4,7 @@
 include(hipblaslt_codegen)
 
 set(TENSILELITE_BUILD_PARALLEL_LEVEL "" CACHE STRING "Number of CPU cores to use for building device libraries (will use nproc if unset).")
+set(TENSILELITE_ASSEMBLER "" CACHE FILEPATH "Assembler used to build device libraries.")
 set(TENSILELITE_KEEP_BUILD_TMP OFF CACHE STRING "Keep temporary build directory for device libraries (turning this ON  bloat the build size).")
 set(TENSILELITE_ASM_DEBUG "" CACHE STRING "Keep debug information for built code objects.")
 set(TENSILELITE_LOGIC_FILTER "" CACHE STRING "Cutomsized logic filter, default is *, i.e. all logics.")
@@ -59,6 +60,7 @@
     TARGET tensilelite-device-libraries
     LOGIC_PATH "${HIPBLASLT_LIBLOGIC_PATH}"
     OUTPUT_DIR "${HIPBLASLT_TENSILE_LIBPATH}"
+    ASSEMBLER "${TENSILELITE_ASSEMBLER}"
     ARCHES ${GPU_TARGETS}
     ${_codegen_host_sanitizer_args}
     ${_codegen_product_args}
diff -ru a/tensilelite/rocisa/rocisa/include/hardware_caps.hpp b/tensilelite/rocisa/rocisa/include/hardware_caps.hpp
--- a/tensilelite/rocisa/rocisa/include/hardware_caps.hpp
+++ b/tensilelite/rocisa/rocisa/include/hardware_caps.hpp
@@ -43,7 +43,8 @@
     std::string isastr = getGfxNameTuple(isaVersion);
 
     std::vector<std::string> cmd
-        = {assemblerPath, "-x", "assembler", "-target", "amdgcn-amdhsa", "-mcpu=" + isastr};
+        = {assemblerPath, "-x", "assembler", "-target", "amdgcn-amdhsa", "-mcpu=" + isastr,
+           "-c", "-o", "/dev/null"};
     for(auto o : options)
     {
         cmd.push_back(o);
