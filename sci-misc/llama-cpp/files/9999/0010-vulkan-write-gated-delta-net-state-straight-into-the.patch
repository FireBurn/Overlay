 }
 
-void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_tensor * dst) {
+static bool ggml_vk_gdn_uses_cm(const vk_device & device, const ggml_tensor * gdn) {
+    const ggml_tensor * src_v = gdn->src[2];
+    const ggml_tensor * src_g = gdn->src[3];
+    const uint32_t S_v      = (uint32_t)src_v->ne[0];
+    const uint32_t n_tokens = (uint32_t)src_v->ne[2];
+    const uint32_t K        = (uint32_t)ggml_get_op_params_i32(gdn, 0);
+    const bool replay = gdn->src[6] != nullptr;
+    const bool keep = replay && ggml_get_op_params_i32(gdn, 2) != 0;
+    // RDNA3: the scan is faster below ~4k tokens
+    const uint32_t cm_min_tokens = device->architecture == AMD_RDNA3 ? 4096u : 64u;
+    return (device->pipeline_gated_delta_net_cm[replay] || device->pipeline_gated_delta_net_cm_v32[replay] ||
+            device->pipeline_gated_delta_net_cm_v128[replay]) &&
+        src_g->ne[0] == 1 && S_v == 128 && gdn->src[0]->ne[0] == 128 && K == 1 && n_tokens >= cm_min_tokens && !keep;
+}
+
+// state_dst: cache view to write the state snapshots to (fused state copy), or nullptr to write them to the tail of dst.
+void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_tensor * dst, const ggml_tensor * state_dst) {
     const ggml_tensor * src_q     = dst->src[0];
     const ggml_tensor * src_k     = dst->src[1];
     const ggml_tensor * src_v     = dst->src[2];
@@ -11401,7 +11417,8 @@ void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx,
     // K (snapshot slot count) is an op param; state holds s0 only [S_v, S_v, H, n_seqs].
     const uint32_t K = (uint32_t)ggml_get_op_params_i32(dst, 0);
 
-    const uint32_t s_off = S_v * H * n_tokens * n_seqs;
+    uint32_t s_off      = S_v * H * n_tokens * n_seqs;
+    uint32_t out_stride = 0;
 
     const ggml_tensor * src_g = dst->src[3];
     const bool replay = dst->src[6] != nullptr;
@@ -11410,10 +11427,8 @@ void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx,
     const vk_pipeline & cm_v32 = ctx->device->pipeline_gated_delta_net_cm_v32[replay];
     const vk_pipeline & cm_v128 = ctx->device->pipeline_gated_delta_net_cm_v128[replay];
     const bool rdna3 = ctx->device->architecture == AMD_RDNA3;
-    // RDNA3: the scan is faster below ~4k tokens
-    const uint32_t cm_min_tokens = rdna3 ? 4096u : 64u;
-    const bool use_cm = (cm || cm_v32 || cm_v128) &&
-        src_g->ne[0] == 1 && S_v == 128 && dst->src[0]->ne[0] == 128 && K == 1 && n_tokens >= cm_min_tokens && !keep;
+    const bool use_cm = ggml_vk_gdn_uses_cm(ctx->device, dst);
+    GGML_ASSERT(!use_cm || state_dst == nullptr);
 
     const bool use_cm2 = use_cm && ctx->device->coopmat2;
     const bool have_v64 = cm != nullptr;
@@ -11446,6 +11461,12 @@ void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx,
     ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
 
     vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, dst);
+    vk_subbuffer state_buf = dst_buf;
+    if (state_dst != nullptr) {
+        state_buf  = ggml_vk_tensor_subbuffer(ctx, state_dst, true);
+        s_off      = get_misalign_bytes(ctx, state_dst) / sizeof(float);
+        out_stride = (uint32_t)(state_dst->nb[1] / sizeof(float));
+    }
     vk_subbuffer src_buf[10] = {};
     for (int i = 0; i < 10; i++) {
         // the replay sources 6..9 bind q when the op has no replay
@@ -11509,6 +11530,7 @@ void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx,
         src_pgb ? (uint32_t)(src_pgb->nb[1] / sizeof(float)) : 0u,
         src_pgb ? (uint32_t)(src_pgb->nb[2] / sizeof(float)) : 0u,
         src_pgb ? (uint32_t)(src_pgb->nb[3] / sizeof(float)) : 0u,
+        out_stride,
     };
 
     const std::array<uint32_t, 3> groups = use_cm ?
@@ -11529,7 +11551,7 @@ void ggml_vk_gated_delta_net(ggml_backend_vk_context * ctx, vk_context& subctx,
     } else {
         ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
             {src_buf[0], src_buf[1], src_buf[2], src_buf[3], src_buf[4], src_buf[5], dst_buf,
-             src_buf[6], src_buf[7], src_buf[8], src_buf[9]},
+             src_buf[6], src_buf[7], src_buf[8], src_buf[9], state_buf},
             pc, groups);
     }
     if (use_v128) {
@@ -13470,6 +13492,9 @@ bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph, in
     if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
         return false;
     }
+    if (node->op == GGML_OP_CPY && !ctx->gdn_elided_cpys.empty() && ctx->gdn_elided_cpys.count(node)) {
+        return false; // written directly by the gated_delta_net
+    }
 
     VK_LOG_DEBUG("ggml_vk_build_graph(" << node << ", " << ggml_op_name(node->op) << ")");
     ctx->semaphore_idx = 0;
@@ -13988,7 +14013,7 @@ bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph, in
         break;
 
     case GGML_OP_GATED_DELTA_NET:
-        ggml_vk_gated_delta_net(ctx, compute_ctx, node);
+        ggml_vk_gated_delta_net(ctx, compute_ctx, node, ctx->gdn_state_dst);
 
         break;
 
@@ -15412,6 +15437,84 @@ bool ggml_vk_can_fuse_snake(ggml_backend_vk_context * ctx, const struct ggml_cgr
     return true;
 }
 
+bool ggml_vk_tensors_overlap(const ggml_tensor * a, const ggml_tensor * b, bool elementwise);
+
+// Find the cpy that scatters gated_delta_net state snapshots into the recurrent cache, so the shader writes the cache and the cpy is skipped.
+// Graph optimization can put other nodes in between, so this is not a contiguous fusion. Returns the cpy node index, or 0.
+static int ggml_vk_find_gdn_state_cpy(const vk_device & device, const struct ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * gdn = cgraph->nodes[node_idx];
+    if (gdn->op != GGML_OP_GATED_DELTA_NET || gdn->type != GGML_TYPE_F32 || (gdn->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    if (ggml_vk_gdn_uses_cm(device, gdn)) {
+        return 0;
+    }
+
+    const ggml_tensor * src_v     = gdn->src[2];
+    const int64_t       S_v       = src_v->ne[0];
+    const int64_t       H         = src_v->ne[1];
+    const int64_t       n_tokens  = src_v->ne[2];
+    const int64_t       n_seqs    = src_v->ne[3];
+    const int64_t       D         = S_v * S_v * H;
+    const int64_t       K         = ggml_get_op_params_i32(gdn, 0);
+    if (K != 1) {
+        return 0;
+    }
+    const size_t        tail_off  = ggml_row_size(GGML_TYPE_F32, S_v * H * n_tokens * n_seqs);
+
+    // the state copy is the first cpy reading this gdn, within a few nodes
+    int j = node_idx + 1;
+    for (; j < cgraph->n_nodes && j <= node_idx + 8; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_CPY && n->src[0]->op == GGML_OP_VIEW && n->src[0]->view_src == gdn) {
+            break;
+        }
+    }
+    if (j >= cgraph->n_nodes || j > node_idx + 8) {
+        return 0;
+    }
+    const ggml_tensor * cpy = cgraph->nodes[j];
+    if (cpy->flags & GGML_TENSOR_FLAG_OUTPUT) {
+        return 0;
+    }
+    const ggml_tensor * src = cpy->src[0];
+    const ggml_tensor * dst = cpy->src[1];
+    if (src->op != GGML_OP_VIEW || src->view_src != gdn || src->view_offs != tail_off || !ggml_is_contiguous(src)) {
+        return 0;
+    }
+    const int64_t expected_ne[GGML_MAX_DIMS] = { D, n_seqs, 1, 1 };
+    if (dst->type != GGML_TYPE_F32 || dst->buffer == nullptr ||
+        !std::equal(expected_ne, expected_ne + GGML_MAX_DIMS, dst->ne) ||
+        dst->nb[0] != sizeof(float) || dst->nb[1] % sizeof(float) != 0 || dst->nb[1] < (size_t) ggml_row_size(GGML_TYPE_F32, D)) {
+        return 0;
+    }
+    // the gdn tail is not written any more, so nothing else may read it
+    for (int k = node_idx + 1; k < cgraph->n_nodes; ++k) {
+        if (k == j) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * t = cgraph->nodes[k]->src[s];
+            if (t && t != src && (t == gdn || t->view_src == gdn) && t->view_offs >= tail_off) {
+                return 0;
+            }
+        }
+    }
+    // the cache is now written before the nodes scheduled between gdn and cpy: they must not touch it
+    for (int k = node_idx + 1; k < j; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_vk_tensors_overlap(n, dst, false)) {
+            return 0;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] && ggml_vk_tensors_overlap(n->src[s], dst, false)) {
+                return 0;
+            }
+        }
+    }
+    return j;
+}
+
 bool ggml_vk_tensors_overlap(const ggml_tensor * a, const ggml_tensor * b, bool elementwise) {
     ggml_backend_vk_buffer_context * a_buf_ctx = (ggml_backend_vk_buffer_context *)a->buffer->context;
     vk_buffer a_buf = a_buf_ctx->dev_buffer;
@@ -15555,6 +15658,7 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
     ctx->prealloc_size_add_rms_partials_offset = 0;
     ctx->do_add_rms_partials = false;
     ctx->do_add_rms_partials_offset_calculation = false;
+    ctx->gdn_elided_cpys.clear();
 
     int last_node = cgraph->n_nodes - 1;
 
@@ -15701,6 +15805,14 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
         ctx->fused_hc_post_gate = false;
         ctx->fused_rms_norm_mode = RMS_NORM_COUNT;
         const char *fusion_string {};
+        static const bool gdn_state_fusion_disabled = getenv("GGML_VK_DISABLE_GDN_STATE_FUSION") != nullptr;
+        ctx->gdn_state_dst = nullptr;
+        if (!ctx->device->disable_fusion && !gdn_state_fusion_disabled && cgraph->nodes[i]->op == GGML_OP_GATED_DELTA_NET) {
+            if (const int j_cpy = ggml_vk_find_gdn_state_cpy(ctx->device, cgraph, i); j_cpy > 0) {
+                ctx->gdn_state_dst = cgraph->nodes[j_cpy]->src[1];
+                ctx->gdn_elided_cpys.insert(cgraph->nodes[j_cpy]);
+            }
+        }
         if (!ctx->device->disable_fusion) {
             uint32_t num_adds = ggml_vk_fuse_multi_add(ctx, cgraph, i);
             if (num_adds) {
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
index 75c32a067..280c11157 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
@@ -47,6 +47,7 @@ layout(push_constant) uniform Parameters {
     uint spk1, spk2, spk3;
     uint spv1, spv2, spv3;
     uint spg1, spg2, spg3;
+    uint out_stride;
 };
 
 layout(binding = 0) readonly  buffer QBuf     { FLOAT_TYPE data_q[];     };
@@ -62,6 +63,8 @@ layout(binding = 7)  readonly buffer PKBuf    { FLOAT_TYPE data_pk[];    };
 layout(binding = 8)  readonly buffer PVBuf    { FLOAT_TYPE data_pv[];    };
 layout(binding = 9)  readonly buffer PGBBuf   { FLOAT_TYPE data_pgb[];   };
 layout(binding = 10) readonly buffer NRepBuf  { int        data_n_rep[]; };
+// Recurrent state output: the tail of dst, or the cache directly when the state copy is fused.
+layout(binding = 11)          buffer StateOutBuf { FLOAT_TYPE data_state_out[]; };
 
 #if !USE_SUBGROUP_ADD && !USE_SUBGROUP_CLUSTERED
 shared FLOAT_TYPE temp[SUBGROUP_SIZE];
@@ -128,6 +131,8 @@ void main() {
     // output state layout per slot: same per-(seq,head) offset as the single-slot case.
     const uint state_out_base      = (seq_id * H + head_id) * state_size;
     const uint state_size_per_snap = state_size * H * n_seqs;
+    // final state: one row per sequence, with the cache's row stride when fused
+    const uint final_out_base      = (out_stride != 0u ? seq_id * out_stride : seq_id * H * state_size) + head_id * state_size;
 
     FLOAT_TYPE s_shard[ROWS_PER_LANE];
     [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
@@ -178,7 +183,7 @@ void main() {
 
         if (keep != 0) {
             [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
-                data_dst[s_off + state_out_base + col * S_V + row_index(r, lane)] = s_shard[r];
+                data_state_out[s_off + final_out_base + col * S_V + row_index(r, lane)] = s_shard[r];
             }
         }
     }
@@ -254,7 +259,7 @@ void main() {
     // replay with keep: the state output is the state after the replay
     if (K == 1u && !(REPLAY != 0 && keep != 0)) {
         [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
-            data_dst[s_off + state_out_base + col * S_V + row_index(r, lane)] = s_shard[r];
+            data_state_out[s_off + final_out_base + col * S_V + row_index(r, lane)] = s_shard[r];
         }
     }
 }
