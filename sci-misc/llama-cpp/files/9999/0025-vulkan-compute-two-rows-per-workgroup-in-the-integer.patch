From 3bde62841d551481646fb938d9eafa7869091289 Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Wed, 21 Oct 2026 12:26:14 +0100
Subject: [PATCH] vulkan : compute two rows per workgroup in the integer
 mat-vec from two columns on RDNA4

The integer mat-vec used one row per workgroup for 2 to 4 columns and four rows
from five columns. Two rows per workgroup from two columns up reloads the
activations half as often. Speculative decoding verification steps of three to
six tokens are 2 to 5% faster on a Radeon AI PRO R9700. Single tokens and RDNA3
are unchanged.

Assisted-by: Claude Code (Claude Sonnet 5.5)
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 07d1080a7..2e08e00d0 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -3446,6 +3446,9 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
                     {GGML_TYPE_IQ1_M,  "mul_mat_vec_iq1_m_q8_1_f32",  arr_dmmv_iq1_m_q8_1_f32_len[reduc],  arr_dmmv_iq1_m_q8_1_f32_data[reduc],  rm_iq_int(i)},
                     {GGML_TYPE_IQ4_XS, "mul_mat_vec_iq4_xs_q8_1_f32", arr_dmmv_iq4_xs_q8_1_f32_len[reduc], arr_dmmv_iq4_xs_q8_1_f32_data[reduc], rm_stdq_int},
                 };
+                const bool is_rdna4 = device->vendor_id == VK_VENDOR_ID_AMD && device->architecture == AMD_RDNA4;
+                // RDNA4: two rows from two columns up bench faster for the speculative decoding verification batches
+                const bool use_two_rows = is_rdna4 && i >= 1;
                 const bool use_four_rows = is_rdna3_or_4 && i >= 4;
                 // RDNA3-class dGPU: legacy quants are faster with 4 rows from 2 columns
                 const bool use_four_rows_stdq = is_rdna3_or_4 && !device->uma && i >= 1;
@@ -3457,7 +3460,9 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
                     const bool is_stdq = shader.type == GGML_TYPE_Q4_0 || shader.type == GGML_TYPE_Q4_1 ||
                                          shader.type == GGML_TYPE_Q5_0 || shader.type == GGML_TYPE_Q5_1 ||
                                          shader.type == GGML_TYPE_Q8_0;
-                    const uint32_t rows = (use_four_rows || (use_four_rows_stdq && is_stdq)) && !use_default_rows ? 4u : shader.default_rows;
+                    const uint32_t rows = (use_four_rows_stdq && is_stdq) ? 4u :
+                                          use_two_rows ? 2u :
+                                          (use_four_rows && !use_default_rows ? 4u : shader.default_rows);
 
                     ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][shader.type][i],
                                             shader.name, shader.spv_size, shader.spv_data, "main", mul_mat_vec_num_bindings,
