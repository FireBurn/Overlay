From 8ab5081447dbf033836fae5a139a0ef3ae94662e Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Thu, 17 Sep 2026 11:48:40 +0100
Subject: [PATCH 04/18] vulkan : use 4 rows for legacy-quant mat-vec from 2
 columns on RDNA3/4

Assisted-by: Claude Code (Claude Opus 5.5)
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 92d1d10..1e29a74 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -3421,12 +3421,19 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
                 };
 
                 const bool use_four_rows = is_rdna3_or_4 && i >= 4;
+                // RDNA3-class dGPU: legacy quants are faster with 4 rows from 2 columns
+                const bool is_rdna3_or_4_dgpu_stdq = is_rdna3_or_4 && !device->uma && i >= 1;
                 const bool rdna4_amd_prop = device->architecture == AMD_RDNA4 && device->driver_id == vk::DriverId::eAmdProprietary;
                 for (const auto & shader : shaders) {
+                    const bool is_legacy_stdq =
+                        shader.type == GGML_TYPE_Q4_0 || shader.type == GGML_TYPE_Q4_1 ||
+                        shader.type == GGML_TYPE_Q5_0 || shader.type == GGML_TYPE_Q5_1 ||
+                        shader.type == GGML_TYPE_Q8_0;
                     // Four rows can be slower for these quants on the AMD proprietary driver.
                     const bool use_default_rows = rdna4_amd_prop &&
                         (shader.type == GGML_TYPE_Q3_K || shader.type == GGML_TYPE_Q5_K || shader.type == GGML_TYPE_IQ4_XS);
-                    const uint32_t rows = use_four_rows && !use_default_rows ? 4u : shader.default_rows;
+                    const uint32_t rows = (is_rdna3_or_4_dgpu_stdq && is_legacy_stdq) ? 4u :
+                                          (use_four_rows && !use_default_rows ? 4u : shader.default_rows);
 
                     ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][shader.type][i],
                                             shader.name, shader.spv_size, shader.spv_data, "main", mul_mat_vec_num_bindings,
