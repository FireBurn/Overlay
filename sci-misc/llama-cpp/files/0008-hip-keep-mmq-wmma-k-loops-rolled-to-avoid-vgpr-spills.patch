From 5b8fe641100b0133b403a0e3e3557f1611ff5224 Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Sat, 26 Sep 2026 14:37:48 +0100
Subject: [PATCH 1/3] HIP: keep MMQ WMMA k-loops rolled to avoid VGPR spills on
 RDNA4

With stock LLVM 23 the k01 loops in the AMD MFMA/WMMA paths of
vec_dot_q8_0_q8_1_mma, vec_dot_q8_0_16_q8_1_mma and vec_dot_q2_K_q8_1_mma
are fully unrolled; the hoisted loads then exceed the 256 VGPR budget and
the J >= 80 kernels spill 300-1200 VGPRs to scratch (iq4_xs J=128: 575).
Pinning the loops to unroll 1 removes the spills.

R9700 (gfx1201), Qwen3.8-27B UD-Q4_K_M, pp512: 298 -> 1246 t/s.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmq-vec-dot.cuh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmq-vec-dot.cuh b/ggml/src/ggml-cuda/mmq-vec-dot.cuh
index 4ca6542d8..c52f1a1df 100644
--- a/ggml/src/ggml-cuda/mmq-vec-dot.cuh
+++ b/ggml/src/ggml-cuda/mmq-vec-dot.cuh
@@ -162,6 +162,9 @@ static __device__ __forceinline__ void ggml_cuda_mmq_vec_dot_q8_0_q8_1_mma(
 
     const int i0 = (threadIdx.y / ntx) * rows_per_warp;
 
+    // Keep the k01 loop rolled: when LLVM unrolls it, hoisted loads for all iterations
+    // exceed the VGPR budget and the J >= 80 kernels spill heavily on RDNA4.
+#pragma unroll 1
     for (int k01 = 0; k01 < MMQ_TILE_NE_K; k01 += QI8_0) {
         const int k0 = k00 + k01;
 
@@ -495,6 +498,7 @@ template <ggml_type type, int J, bool fallback, ggml_prec prec_src1 = GGML_PREC_
 
     const int i0 = (threadIdx.y / ntx) * rows_per_warp;
 
+#pragma unroll 1
     for (int k01 = 0; k01 < MMQ_TILE_NE_K; k01 += 4) {
         const int k0 = k00 + k01;
 
@@ -693,6 +697,7 @@ template <ggml_type type, int J, bool fallback> static __device__ __forceinline_
 
     const int i0 = (threadIdx.y / ntx) * rows_per_warp;
 
+#pragma unroll 1
     for (int k01 = 0; k01 < MMQ_TILE_NE_K; k01 += 4) {
         const int k0 = k00 + k01;
 
