NPM_PNPM_VERSION="10.28.0"
ELECTRON_SLOT="44"

inherit desktop edo electron npm xdg

DESCRIPTION="GOG, Epic Games and Amazon Games launcher"
HOMEPAGE="https://heroicgameslauncher.com/
	https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher"
SRC_URI="
	https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/archive/refs/tags/v${PV}.tar.gz
		-> ${P}.gh.tar.gz
	${NPM_PKG_URIS}
"
S="${WORKDIR}/HeroicGamesLauncher-${PV}"

LICENSE="GPL-3"
# Bundled npm packages
LICENSE+=" 0BSD Apache-2.0 BSD BSD-2 CC0-1.0 ISC MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="gamescope +vulkan"
RESTRICT="mirror test"

# Heroic runs these store tools; upstream downloads prebuilt copies
RDEPEND+="
	!games-util/heroic-bin
	games-util/comet
	games-util/gogdl
	games-util/legendary
	games-util/nile
	gamescope? ( gui-wm/gamescope )
	vulkan? ( games-util/vulkan-helper )
"
BDEPEND="${NPM_NODE_DEPEND}"

# Electron reports the app as unpackaged when it is run as a directory, which
# sends Heroic looking for its UI and assets in the source layout
PATCHES=( "${FILESDIR}/${P}-system-electron-paths.patch" )

src_compile() {
	electron_setup_env

	npm_with_registry pnpm install --frozen-lockfile
	edo pnpm run build

	# The installed app gets a production-only node_modules
	local prod="${WORKDIR}/prod"
	mkdir -p "${prod}" || die
	cp -r package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc patches "${prod}" || die
	pushd "${prod}" >/dev/null || die
	npm_with_registry pnpm install --frozen-lockfile --prod --ignore-scripts
	popd >/dev/null || die
}

src_install() {
	local app="$(electron_app_dir)"

	insinto "${app}"
	doins package.json
	doins -r build "${WORKDIR}/prod/node_modules"

	# Upstream commits these as prebuilt binaries
	find "${ED}${app}" -name vulkan-helper -delete || die

	local tool tools=( legendary gogdl nile comet )
	local bindir="${app}/build/bin/$(usex arm64 arm64 x64)/linux"
	use vulkan && tools+=( vulkan-helper )
	for tool in "${tools[@]}"; do
		dosym -r "/usr/bin/${tool}" "${bindir}/${tool}"
	done

	electron_make_launcher heroic

	newicon flatpak/com.heroicgameslauncher.hgl.png com.heroicgameslauncher.hgl.png
	sed -e 's/^Exec=heroic-run /Exec=heroic /' \
		flatpak/com.heroicgameslauncher.hgl.desktop > "${T}/heroic.desktop" || die
	newmenu "${T}/heroic.desktop" com.heroicgameslauncher.hgl.desktop

	if use gamescope; then
		sed -e 's/^Name=Heroic Games Launcher/& (Gamescope)/' \
			-e 's/^Exec=heroic /Exec=env GDK_BACKEND=wayland gamescope -f -R --RT --force-grab-cursor --prefer-vk-device --adaptive-sync --nested-unfocused-refresh 30 -- heroic --ozone-platform=x11 --enable-features=UseOzonePlatform,WaylandWindowDecorations /' \
			"${T}/heroic.desktop" > "${T}/heroic-gamescope.desktop" || die
		newmenu "${T}/heroic-gamescope.desktop" com.heroicgameslauncher.hgl.gamescope.desktop
	fi

	dodoc README.md CHANGELOG.md
}
