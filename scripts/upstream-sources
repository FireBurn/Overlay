# Where bump-ebuilds.sh finds each package's latest upstream version.
# Read by scripts/upstream-version.py.
#
#   category/package  METHOD ARGS... [option=value ...]
#   @group            METHOD ARGS... [option=value ...]
#   category/package  @group
#
# Methods:
#   github-release OWNER/REPO    non-prerelease GitHub releases
#   github-tag     OWNER/REPO    GitHub tags
#   github-commit  OWNER/REPO    newest default-branch commit, as <base>_pYYYYMMDD
#                                or YYYYMMDD for date-only versions
#   gitlab-tag     GROUP/PROJECT GitLab tags (host=gitlab.com by default)
#   git-tag        URL           tags from git ls-remote
#   pypi           NAME
#   npm            NAME
#   text           URL           response body is the version
#   json           URL KEY       dotted KEY in the JSON response
#   page           URL REGEX...  highest REGEX group 1 match in the page; further
#                                URL REGEX pairs may use {} for the previous match
#   agent          NOTE...       no automatic check; the agent assesses it
#   skip           NOTE...       never checked
#
# Options:
#   prefix=  suffix=  tag text removed before and after the version
#   sep=     separator used in place of "." (e.g. doxygen Release_1_14_0)
#   pad=N    pad the version to N components (therock-10.0 -> 10.0.0)
#   match=   only consider versions matching this regex
#   pre=1    include GitHub prereleases
#   batch=1  (groups) hand all outdated members to one agent run
#
# Packages built only as live ebuilds are skipped automatically.

@rocm       github-release ROCm/rocm-systems prefix=therock- pad=3 batch=1

