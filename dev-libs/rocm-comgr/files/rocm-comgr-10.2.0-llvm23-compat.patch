+} // namespace compat
+
+enum AMDGPUFeature : unsigned {
+  FEAT_IMAGE_INSTS = compat::F_IMAGE_INSTS,
+  FEAT_GFX10_INSTS = compat::F_GFX10_INSTS,
+  FEAT_GFX10_3_INSTS = compat::F_GFX10_3_INSTS,
+  FEAT_GFX90A_INSTS = compat::F_GFX90A_INSTS,
+  FEAT_SRAMECC_SUPPORT = compat::F_SRAMECC_SUPPORT,
+  FEAT_XNACK_ON_OFF_MODES = compat::F_XNACK_ON_OFF_MODES,
+  FEAT_SGPR_INIT_BUG = compat::F_SGPR_INIT_BUG,
+  FEAT_1536_PHYSICAL_VGPRS = compat::F_1536_PHYSICAL_VGPRS,
+  FEAT_1024_ADDRESSABLE_VGPRS = compat::F_1024_ADDRESSABLE_VGPRS,
+  FEAT_HALF_ADDRESSABLE_PHYSICAL_LOCAL_MEMORY =
+      compat::F_HALF_ADDRESSABLE_PHYSICAL_LOCAL_MEMORY,
+};
+
+struct AMDGPUFeatureBitset {
+  unsigned Bits = 0;
+  bool test(unsigned F) const { return Bits & F; }
+};
+
+inline AMDGPUFeatureBitset getFeatureBitset(GPUKind Kind) {
+  const compat::GPUData *D = compat::find(Kind);
+  return AMDGPUFeatureBitset{D ? D->Features : 0};
+}
+
+enum { FIXED_NUM_SGPRS_FOR_INIT_BUG = 96 };
+
+inline unsigned getTotalNumSGPRs(GPUKind Kind) {
+  const compat::GPUData *D = compat::find(Kind);
+  return D && D->Major >= 8 ? 800 : 512;
+}
+
+inline unsigned getAddressableNumSGPRs(GPUKind Kind) {
+  if (getFeatureBitset(Kind).test(FEAT_SGPR_INIT_BUG))
+    return FIXED_NUM_SGPRS_FOR_INIT_BUG;
+  const compat::GPUData *D = compat::find(Kind);
+  unsigned Major = D ? D->Major : 0;
+  if (Major >= 10)
+    return 106;
+  if (Major >= 8)
+    return 102;
+  return 104;
+}
+
+inline unsigned getSGPRAllocGranule(GPUKind Kind) {
+  const compat::GPUData *D = compat::find(Kind);
+  unsigned Major = D ? D->Major : 0;
+  if (Major >= 10)
+    return getAddressableNumSGPRs(Kind);
+  if (Major >= 8)
+    return 16;
+  return 8;
+}
+
+inline unsigned getVGPRAllocGranule(GPUKind Kind, bool IsWave32) {
+  AMDGPUFeatureBitset F = getFeatureBitset(Kind);
+  if (F.test(FEAT_GFX90A_INSTS))
+    return 8;
+  if (F.test(FEAT_1536_PHYSICAL_VGPRS))
+    return IsWave32 ? 24 : 12;
+  if (F.test(FEAT_GFX10_3_INSTS))
+    return IsWave32 ? 16 : 8;
+  return IsWave32 ? 8 : 4;
+}
+
+inline unsigned getTotalNumVGPRs(GPUKind Kind, bool IsWave32) {
+  AMDGPUFeatureBitset F = getFeatureBitset(Kind);
+  if (F.test(FEAT_GFX90A_INSTS))
+    return 512;
+  if (!F.test(FEAT_GFX10_INSTS))
+    return 256;
+  if (F.test(FEAT_1536_PHYSICAL_VGPRS))
+    return IsWave32 ? 1536 : 768;
+  return IsWave32 ? 1024 : 512;
+}
+
+inline unsigned getAddressableNumVGPRs(GPUKind Kind, bool IsWave32) {
+  AMDGPUFeatureBitset F = getFeatureBitset(Kind);
+  if (F.test(FEAT_GFX90A_INSTS))
+    return 512;
+  if (F.test(FEAT_1024_ADDRESSABLE_VGPRS))
+    return IsWave32 ? 1024 : 512;
+  return 256;
+}
+
+inline unsigned getMaxHWAddressableLocalMemorySize(GPUKind Kind) {
+  const compat::GPUData *D = compat::find(Kind);
+  return D ? D->MaxHWLocalMemory : 32768;
+}
+
+inline unsigned getLocalMemorySize(GPUKind Kind, bool FullSIMDMode) {
+  unsigned Size = getMaxHWAddressableLocalMemorySize(Kind);
+  if (getFeatureBitset(Kind).test(FEAT_HALF_ADDRESSABLE_PHYSICAL_LOCAL_MEMORY))
+    Size *= 2;
+  if (!FullSIMDMode)
+    Size /= 2;
+  return Size;
+}
+
+inline unsigned getLDSBankCount(GPUKind Kind) {
+  const compat::GPUData *D = compat::find(Kind);
+  return D ? D->LDSBankCount : 32;
+}
+
+inline unsigned getMaxWavesPerEU(GPUKind Kind) {
+  const compat::GPUData *D = compat::find(Kind);
+  return D ? D->MaxWavesPerEU : 10;
+}
+
+constexpr unsigned getMaxFlatWorkGroupSize() { return 1024; }
+
